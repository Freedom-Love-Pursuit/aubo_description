<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="aubo_robot" params="aubo_type transmission_hw_interface">
    <xacro:include filename="$(find aubo_description)/urdf/${aubo_type}.urdf.xacro" />
    <joint name="ee_fixed_joint" type="fixed">
      <parent link="wrist3_Link" />
      <child link ="ee_link" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${pi/2.0}" />
    </joint>

    <!-- Virtual end-effector frame; physical flange geometry belongs to wrist3_Link. -->
    <link name="ee_link"/>

    <!-- Intel RealSense D435i camera base frame -->
    <link name="camera_link"/>

    <!-- Authoritative wrist handeye; byte-identical pinned source, SHA256
         7b9438e139e2dd6b12a6a630dcf6cfe950e38f31f8ebeb548fe350cdfb833e2d.
         RSP owns this edge. External handeye tool must use its verify-existing mode.
         URDF RPY is fixed-axis XYZ; derive it from the original rotation matrix. -->
    <xacro:property name="wrist_handeye" value="${xacro.load_yaml('$(find aubo_description)/urdf/calibration/handeye_d435_20261021_urdf.json')}"/>
    <xacro:property name="wrist_T" value="${wrist_handeye['ee_link_T_camera_link']}"/>
    <joint name="camera_fixed_joint" type="fixed">
      <parent link="ee_link"/>
      <child link="camera_link"/>
      <origin
        xyz="${wrist_T[0][3]} ${wrist_T[1][3]} ${wrist_T[2][3]}"
        rpy="${atan2(wrist_T[2][1], wrist_T[2][2])} ${atan2(-wrist_T[2][0], sqrt(wrist_T[2][1]**2 + wrist_T[2][2]**2))} ${atan2(wrist_T[1][0], wrist_T[0][0])}"/>
    </joint>

    <transmission name="shoulder_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="shoulder_joint">
        <hardwareInterface>${transmission_hw_interface}</hardwareInterface>
      </joint>
      <actuator name="shoulder_motor">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="foreArm_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="foreArm_joint">
        <hardwareInterface>${transmission_hw_interface}</hardwareInterface>
      </joint>
      <actuator name="foreArm_motor">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="upperArm_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="upperArm_joint">
        <hardwareInterface>${transmission_hw_interface}</hardwareInterface>
      </joint>
      <actuator name="upperArm_motor">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="wrist1_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="wrist1_joint">
        <hardwareInterface>${transmission_hw_interface}</hardwareInterface>
      </joint>
      <actuator name="wrist1_motor">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="wrist2_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="wrist2_joint">
        <hardwareInterface>${transmission_hw_interface}</hardwareInterface>
      </joint>
      <actuator name="wrist2_motor">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="wrist3_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="wrist3_joint">
        <hardwareInterface>${transmission_hw_interface}</hardwareInterface>
      </joint>
      <actuator name="wrist3_motor">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <gazebo reference="shoulder_Link">
      <selfCollide>true</selfCollide>
    </gazebo>
    <gazebo reference="upperArm_Link">
      <selfCollide>true</selfCollide>
    </gazebo>
    <gazebo reference="foreArm_Link">
      <selfCollide>true</selfCollide>
    </gazebo>
    <gazebo reference="wrist1_Link">
      <selfCollide>true</selfCollide>
    </gazebo>
    <gazebo reference="wrist2_Link">
      <selfCollide>true</selfCollide>
    </gazebo>
    <gazebo reference="wrist3_Link">
      <selfCollide>true</selfCollide>
    </gazebo>
    <gazebo reference="ee_link">
      <selfCollide>true</selfCollide>
    </gazebo>
    <gazebo>
      <!-- plugin name="ros_control" filename="libgazebo_ros_control.so"/ -->
    </gazebo>

  </xacro:macro>
</robot>
